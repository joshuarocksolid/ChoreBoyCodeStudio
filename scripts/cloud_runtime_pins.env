# Pinned cloud runtimes. Sourced by scripts/cloud_runtime_lib.sh.
# FreeCAD checksums are the upstream SHA256 files on the GitHub release.
# Miniconda checksum is sha256sum of the installer named below.

FREECAD_10_VERSION=1.0.2
FREECAD_10_SHA256=e00be00ad9fdb12b05c5002bfd1aa2ea8126f2c1d4e2fb603eb7423b72904f61
FREECAD_10_FILENAME=FreeCAD_1.0.2-conda-Linux-x86_64-py311.AppImage
FREECAD_10_URL=https://github.com/FreeCAD/FreeCAD/releases/download/1.0.2/FreeCAD_1.0.2-conda-Linux-x86_64-py311.AppImage
FREECAD_10_DEST=/opt/freecad

FREECAD_11_VERSION=1.1.4
FREECAD_11_SHA256=f6dc6ba676e5ac96a565ebc8d657232f94c6158e85b4352141bd1a46f6b43434
FREECAD_11_FILENAME=FreeCAD_1.1.4-Linux-x86_64-py311.AppImage
FREECAD_11_URL=https://github.com/FreeCAD/FreeCAD/releases/download/1.1.4/FreeCAD_1.1.4-Linux-x86_64-py311.AppImage
FREECAD_11_DEST=/opt/freecad-1.1

# conda-forge has no freecad 1.0.2. 1.0.0 is the last 1.0 build with a py39 package.
FREECAD_CONDA_PKG=freecad=1.0.0

